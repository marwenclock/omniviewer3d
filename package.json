{
  "name": "omniviewer3d",
  "version": "1.0.0",
  "description": "OMNIVIEWER by BANKASI MEDIA: a free, open-source, ad-free online 3D toolkit (viewer, converter, scaler, measure, paint and lightweight editor) that runs in your browser.",
  "scripts": {
    "predev": "node scripts/copy-libs.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-libs.mjs",
    "build": "vite build && node scripts/generate-pages.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "deploy": "npm run build && wrangler deploy"
  },
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@mkkellogg/gaussian-splats-3d": "^0.4.7",
    "fflate": "^0.8.3",
    "geist": "^1.9.2",
    "gifenc": "^1.0.3",
    "occt-import-js": "^0.0.23",
    "opentype.js": "^2.0.0",
    "rhino3dm": "^8.35.0",
    "three": "^0.187.0",
    "three-bvh-csg": "^0.0.18",
    "three-mesh-bvh": "^0.9.18",
    "web-ifc": "^0.0.79"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/three": "^0.187.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "wrangler": "^4.163.0"
  },
  "private": true,
  "keywords": [
    "3d",
    "viewer",
    "three.js",
    "gltf",
    "obj",
    "stl",
    "step",
    "ifc",
    "fbx",
    "3dm"
  ]
}
