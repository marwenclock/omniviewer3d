// Cloudflare Workers static-assets deployment for omniviewer3d.com.
// Deploy with: npm run deploy   (builds, then uploads dist/)
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "omniviewer3d",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [
    { "pattern": "omniviewer3d.com", "custom_domain": true },
    { "pattern": "www.omniviewer3d.com", "custom_domain": true }
  ]
}
